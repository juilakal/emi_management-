# EMI Management System - Environment Configuration Example
# Copy this file to .env and customize with your local settings.

# Flask Application Settings
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=replace-with-a-secure-random-secret-key-32-chars-minimum

# MySQL Database Configuration
# Format: mysql+pymysql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=emi_management_db

# Full Database URL (Optional override; if set, this takes precedence)
# DATABASE_URL=mysql+pymysql://root:your_mysql_password@127.0.0.1:3306/emi_management_db

# Test Database URL (Used for running isolated test suites)
# TEST_DATABASE_URL=sqlite:///:memory:
